{
  "name": "ember-codemod-v1-to-v2",
  "version": "4.2.6",
  "description": "Codemod to convert Ember addons to v2 addon format",
  "keywords": [
    "codemod",
    "ember-codemod",
    "ember-octane",
    "ember-polaris",
    "ember-v2-addon",
    "emberjs",
    "embroider"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ijlee2/ember-codemod-v1-to-v2.git"
  },
  "license": "MIT",
  "author": "Isaac J. Lee",
  "type": "module",
  "main": "dist/src/index.js",
  "bin": "dist/bin/ember-codemod-v1-to-v2.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "sh build.sh --production",
    "format": "prettier . --cache --write",
    "lint": "concurrently \"pnpm:lint:*(!fix)\" --names \"lint:\"",
    "lint:fix": "concurrently \"pnpm:lint:*:fix\" --names \"fix:\" && pnpm format",
    "lint:format": "prettier . --cache --check",
    "lint:js": "oxlint",
    "lint:js:fix": "oxlint --fix",
    "lint:types": "tsc --noEmit",
    "prepare": "pnpm build",
    "release:prepare": "changeset version",
    "release:publish": "pnpm build && changeset publish",
    "test": "sh build.sh --test && mt dist-for-testing --quiet"
  },
  "dependencies": {
    "@codemod-utils/blueprints": "^3.2.1",
    "@codemod-utils/files": "^4.1.2",
    "@codemod-utils/package-json": "^4.1.4",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@codemod-utils/tests": "^3.3.1",
    "@ijlee2-frontend-configs/changesets": "^3.0.4",
    "@ijlee2-frontend-configs/oxlint-node": "^0.3.2",
    "@ijlee2-frontend-configs/prettier": "^3.4.4",
    "@ijlee2-frontend-configs/typescript": "^4.4.1",
    "@types/node": "^22.20.5",
    "@types/yargs": "^17.0.35",
    "concurrently": "^10.0.6",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "22.* || >= 24"
  }
}
